# --- LLM ---
# mock — офлайн-режим без ключа (детерминированная эвристика вместо модели, для тестов)
# openai — любой OpenAI-совместимый API. Раскомментируйте ОДИН из вариантов ниже.
LLM_PROVIDER=mock

# Вариант 1. Groq (облако, есть бесплатный тариф; ключ: console.groq.com → API Keys)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile

# Вариант 2. Ollama (локально, без ключа; сначала: ollama pull qwen2.5:7b)
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_TIMEOUT_S=180
# RUN_TIMEOUT_S=900

# Вариант 3. OpenAI
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0.2
LLM_RETRIES=2

# Проверка подключения: python -m marketmas llm-check

# --- Лимиты ---
MAX_STEPS=60
RUN_TIMEOUT_S=300
MAX_REVISIONS=2
TOOL_RETRIES=2
LOOP_REPEAT_LIMIT=3

# --- Внешние источники ---
OPENALEX_MAILTO=
HTTP_TIMEOUT_S=8

# --- Внедрение отказов (для тестов): openalex_down,sim_flaky,llm_garbage,critic_reject,analyst_hallucinate,slow_sim
FAULTS=
