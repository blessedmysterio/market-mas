# --- LLM ---
# mock — офлайн-режим без ключа; openai — любой OpenAI-совместимый API (OpenAI, Groq, OpenRouter, Ollama)
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_RETRIES=2

# --- Лимиты ---
MAX_STEPS=60
RUN_TIMEOUT_S=300
MAX_REVISIONS=2
TOOL_RETRIES=2
LOOP_REPEAT_LIMIT=3

# --- Внешние источники ---
OPENALEX_MAILTO=
HTTP_TIMEOUT_S=8

# --- Внедрение отказов (для тестов): openalex_down,sim_flaky,llm_garbage,critic_reject,analyst_hallucinate,slow_sim
FAULTS=
